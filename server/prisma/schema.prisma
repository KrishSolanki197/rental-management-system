generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model customers {
  customer_id BigInt      @id @default(autoincrement())
  user_id     BigInt?     @unique
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  addresses   addresses[]
  users       users?      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_customers_user")
}

model roles {
  role_id    Int          @id @default(autoincrement())
  role_name  String       @unique @db.VarChar(20)
  user_roles user_roles[]
}

model user_roles {
  user_id BigInt
  role_id Int
  roles   roles  @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
}

model users {
  user_id               BigInt       @id @default(autoincrement())
  username              String       @unique @db.VarChar(100)
  email                 String       @unique @db.VarChar(100)
  password_hash         String?
  phone_no              String?      @db.VarChar(20)
  provider              providers    @default(local)
  provider_user_id      String?      @db.VarChar(100)
  user_status           u_status?    @default(active)
  email_verified        Boolean      @default(false)
  last_login_at         DateTime?    @db.Timestamptz(6)
  failed_login_attempts Int?         @default(0) @db.SmallInt
  created_at            DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?    @default(now()) @db.Timestamptz(6)
  customers             customers?
  profiles              profiles?
  user_otp              user_otp[]
  user_roles            user_roles[]
}

model addresses {
  address_id     BigInt    @id @default(autoincrement())
  customer_id    BigInt
  city           String    @db.VarChar(100)
  street_name    String    @db.VarChar(100)
  landmark       String    @db.VarChar(100)
  postal_code    String    @db.VarChar(10)
  state          String    @db.VarChar(50)
  country        String    @db.VarChar(100)
  active_address Boolean   @default(false)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  customers      customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id], map: "idx_addresses_customer")
}

model profiles {
  profile_id        BigInt    @id @default(autoincrement())
  user_id           BigInt    @unique
  first_name        String    @db.VarChar(50)
  last_name         String    @db.VarChar(50)
  date_of_birth     DateTime? @db.Date
  gender            genders?  @default(not_specified)
  profile_image_url String?
  bio               String?   @db.VarChar(150)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  users             users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "idx_profiles_user")
}

model user_otp {
  otp_id     BigInt      @id @default(autoincrement())
  user_id    BigInt
  otp_code   String      @db.Char(6)
  purpose    otp_purpose
  expire_at  DateTime    @db.Timestamptz(6)
  used_at    DateTime?   @db.Timestamptz(6)
  created_at DateTime?   @default(now()) @db.Timestamptz(6)
  users      users       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

enum genders {
  male
  female
  others
  not_specified @map("not specified")
}

enum otp_purpose {
  login
  password_reset
  email_verification
}

enum providers {
  local
  google
}

enum u_status {
  active
  inactive
  suspended
}
